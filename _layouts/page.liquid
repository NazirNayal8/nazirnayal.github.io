---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  <header class="post-header{% if page.motif %} has-motif{% endif %}">
    <div class="post-header-copy">
      <h1 class="post-title">{{ page.title }}</h1>
      <p class="post-description">{{ page.description }}</p>
    </div>
    {% if page.motif %}
      {% comment %} Project pages get a toy dataset chosen from the title, so neighbors differ. {% endcomment %}
      {% assign motif_variant = page.motif_variant | default: page.title.size %}
      {% include motif.liquid name=page.motif variant=motif_variant %}
    {% endif %}
  </header>

  <article>
    {{ content }}
  </article>

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
