---
layout: default
---
<div class="post about-page">
  {% comment %}
    The header: name and statement beside the photo and contact details, then a wide band below
    with the research showcase (assets/js/home.js), which plays the problems one after another.
  {% endcomment %}
  <header class="post-header about-header">
    <div class="about-heading">
      <h1 class="post-title">
        {% if site.title == 'blank' %}
          <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
          {{ site.last_name }}
        {% else %}
          {{ site.title }}
        {% endif %}
      </h1>
      <p class="desc">{{ page.subtitle }}</p>
      {% if page.statement %}<p class="about-statement">{{ page.statement }}</p>{% endif %}
    </div>
    {% if page.profile %}
      <aside class="profile">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid profile-portrait' %}
          {% endif %}
          {% capture sizes %}(min-width: 768px) 220px, 60vw{% endcapture %}
          <div class="profile-photo" data-denoise-photo>
            {%
              include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
              cache_bust=true
            %}
            {% comment %} Hide the photo before first paint; home.js samples it from noise, and CSS reveals it after 5 s if that script never runs. {% endcomment %}
            <script>
              if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) document.currentScript.parentElement.classList.add('is-sampling');
            </script>
          </div>
        {% endif %}
        {% comment %} Email and profile links, centred under the photo. {% endcomment %}
        {% if page.social %}
          <div class="social profile-contact">
            {% if site.email %}
              <a class="profile-email" href="mailto:{{ site.email | encode_email }}">{{ site.email }}</a>
            {% endif %}
            <div class="contact-icons">{% include social.liquid %}</div>
          </div>
        {% endif %}
      </aside>
    {% endif %}
    <div class="showcase-panel" data-showcase-control hidden>
      <div class="showcase-topics" role="group" aria-label="Research problems shown in the animation">
        <button class="motif-toggle" type="button" data-showcase-toggle aria-label="Pause animation" aria-pressed="false" title="Pause animation">
          <svg class="motif-pause-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 4v8M10 4v8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
          <svg class="motif-play-icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="m6 3 7 5-7 5V3Z" /></svg>
        </button>
        <button type="button" data-showcase-topic="flow" aria-pressed="true">MixFlow</button>
        <button type="button" data-showcase-topic="forecast" aria-pressed="false">Uncertainty</button>
        <button type="button" data-showcase-topic="plan" aria-pressed="false">World Models</button>
        <button type="button" data-showcase-topic="latent" aria-pressed="false">Representation</button>
      </div>
      <div class="showcase-space" data-showcase-space><canvas aria-hidden="true"></canvas></div>
      <p class="showcase-caption" data-showcase-caption>Mixing the source straightens paths to the data</p>
    </div>
  </header>

  <article>
    <div class="about-intro">
      <div class="about-copy">{{ content }}</div>
    </div>

    {% include affiliations.liquid %}

    <!-- News -->
    {% if page.news and site.announcements.enabled %}
      <section class="home-section" aria-labelledby="news-heading">
        <h2 id="news-heading" class="section-heading">
          <a href="{{ '/news/' | relative_url }}" style="color: inherit">News</a>
        </h2>
        {% include news.liquid limit=true %}
      </section>
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <section class="home-section" aria-labelledby="papers-heading">
        <h2 id="papers-heading" class="section-heading">
          <a href="{{ '/publications/' | relative_url }}" style="color: inherit">Selected publications</a>
        </h2>
        {% include selected_papers.liquid %}
      </section>
    {% endif %}

    <!-- Latest posts -->
    {% if site.latest_posts.enabled %}
      <section class="home-section" aria-labelledby="posts-heading">
        <h2 id="posts-heading" class="section-heading">
          <a href="{{ '/blog/' | relative_url }}" style="color: inherit">Latest posts</a>
        </h2>
        {% include latest_posts.liquid %}
      </section>
    {% endif %}

    <!-- Social -->
    {% if page.social and page.profile == nil %}
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter.enabled and site.footer_fixed %}
      {% include scripts/newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
