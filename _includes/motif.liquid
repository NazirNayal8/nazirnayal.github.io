{% comment %}
  Research motif: a canvas animation drawn by assets/js/motifs.js.
  Parameters: name (rollout, mixflow, plan, paths, portrait, forecast, toy, ood), class,
  variant, left and right (caption labels). The canvas is decorative; without JavaScript
  the figure collapses to nothing.
{% endcomment %}
{% assign motif_name = include.name | default: page.motif %}
<figure
  class="motif motif-{{ motif_name }} {{ include.class }}"
  data-motif="{{ motif_name }}"
  {% if include.variant %}
    data-variant="{{ include.variant }}"
  {% endif %}
  {% if motif_name == 'portrait' and site.data.portrait_halftone %}
    data-cols="{{ site.data.portrait_halftone.cols }}" data-rows="{{ site.data.portrait_halftone.rows }}"
    data-luminance="{{ site.data.portrait_halftone.luminance }}" data-weight="{{ site.data.portrait_halftone.weight }}"
  {% endif %}
>
  <canvas aria-hidden="true"></canvas>
  <figcaption class="motif-caption">
    <span class="motif-label" aria-hidden="true">{{ include.left }}</span>
    <span class="motif-label" aria-hidden="true">{{ include.right }}</span>
    <button class="motif-toggle" type="button" aria-label="Pause animation" aria-pressed="false" title="Pause animation" hidden>
      <svg class="motif-pause-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 4v8M10 4v8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
      <svg class="motif-play-icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="m6 3 7 5-7 5V3Z" /></svg>
    </button>
  </figcaption>
</figure>
